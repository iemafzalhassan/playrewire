  "font": {
    "display": "'Caveat', 'Segoe Print', 'Bradley Hand', cursive",
    "body": "'Atkinson Hyperlegible', 'Segoe UI', system-ui, sans-serif",
    "code": "'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace",
    "dyslexic": "'OpenDyslexic', 'Atkinson Hyperlegible', sans-serif"
  },
  "size": {
    "text-sm": "0.875rem",
