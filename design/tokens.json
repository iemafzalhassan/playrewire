{
  "$comment": "Single source of design tokens (spec 6.2). apps/web/scripts/tokens.ts turns this into apps/web/src/design/tokens.css. Shared by the web app, the lesson UI and the game HUD.",
  "color": {
    "paper": "#f6f0e4",
    "paper-deep": "#ece3d0",
    "ink": "#2a2620",
