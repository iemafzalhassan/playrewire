{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rewire",
  "version": "0.1.0",
  "identifier": "dev.playrewire.rewire",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter web dev",
    "beforeBuildCommand": "pnpm --filter web build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Rewire",
        "width": 1100,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560,
        "backgroundColor": "#f6f0e4"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "Education",
    "license": "Apache-2.0",
    "homepage": "https://github.com/iemafzalhassan/playrewire",
    "shortDescription": "A free game that turns beginners into real engineers.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "bubblewrap"
        ],
        "files": {
          "/usr/share/rewire/apparmor/dev.playrewire.rewire": "../../../packaging/linux/apparmor/dev.playrewire.rewire"
        },
        "postInstallScript": "../../../packaging/linux/deb/postinst",
        "preRemoveScript": "../../../packaging/linux/deb/prerm"
      },
      "rpm": {
        "depends": [
          "bubblewrap"
        ]
      }
    }
  }
}
